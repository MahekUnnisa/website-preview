# Single-stage build with Node serve
# Final image size: ~180MB (larger than nginx but still reasonable)
# Best for: Development, docker-compose setups, simpler deployments

FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies (need devDependencies for build)
RUN npm ci

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Install only production dependencies + serve
RUN npm ci --only=production && \
    npm install -g serve@14.2.5

# Remove source files to reduce size (keep only dist)
RUN rm -rf src public node_modules

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000/ || exit 1

# Start serve
CMD ["serve", "-s", "dist", "-l", "3000"]

