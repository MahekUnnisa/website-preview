# ZeroAI Website Environment Configuration
# =============================================================================
# This file contains environment variables for the ZeroAI Website Docker setup.
# Copy this file to .env and modify values as needed.
# =============================================================================

# -----------------------------------------------------------------------------
# Port Configuration
# -----------------------------------------------------------------------------
# The port on which the ZeroAI website will be accessible on the host machine.
# The container internally serves on port 80, but this maps to your chosen host port.
# Default: 3000
# Examples:
#   - Development: 3000
#   - Production: 80 (requires root/admin privileges)
#   - Custom: 8080, 8888, etc.
# -----------------------------------------------------------------------------
ZEROAI_PORT=3000
