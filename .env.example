# ZeroAI Website Environment Configuration
# =============================================================================
# Build-time variables consumed by Vite (`import.meta.env`). They are inlined
# into the bundle at build time, so changing one requires a rebuild. None of
# them are secrets — every value here is readable in the shipped JavaScript.
#
# All three have production defaults baked into src/lib/env.js, so a build with
# none of them set still works. Set them only to point a build somewhere else.
#
# Local dev:  cp .env.example .env.local  (then adjust)
# Production: optional — the defaults below are already the production values.
# =============================================================================

# Base URL of the partner API used by /claim and /partner/success.
# Must include the API version segment; the code appends /partner-access/...
# The API's CORS allowlist must include this site's origin.
# Default: https://api.zeroai.co.in/v2
VITE_API_BASE_URL=https://api.zeroai.co.in/v2

# Target of chrome.runtime.sendMessage for one-click sync from /partner/success.
# The extension's manifest externally_connectable.matches must list this site.
# chrome://extensions → ZeroAI → Id
# Default: hplbpdkajdhlggncdpdmnkjldopmoomg
VITE_EXTENSION_ID=hplbpdkajdhlggncdpdmnkjldopmoomg

# Primary “Install” CTA shown when the extension is missing.
# Default: the live Chrome Web Store listing
VITE_CHROME_WEBSTORE_URL=https://chromewebstore.google.com/detail/zeroai-your-ai-work-assis/hplbpdkajdhlggncdpdmnkjldopmoomg
