# ZeroAI Website Environment Configuration
# =============================================================================
# Build-time variables consumed by Vite (`import.meta.env`). They are inlined
# into the bundle at build time, so changing one requires a rebuild.
#
# Local dev:  cp .env.example .env.local  (then fill in the values)
# Production: set these in the Cloudflare Pages project settings, for BOTH the
#             Production and Preview environments.
# =============================================================================

# Base URL of the partner API used by /claim and /partner/success.
# The API's CORS allowlist must include this site's origin.
VITE_API_BASE_URL=http://localhost:3000/v2

# chrome://extensions → ZeroAI → Id (for one-click sync from /partner/success)
VITE_EXTENSION_ID=

# Primary “Install” CTA on /partner/success when the extension is missing
# (optional; defaults to the live Chrome Web Store listing)
VITE_CHROME_WEBSTORE_URL=https://chromewebstore.google.com/detail/zeroai-your-ai-work-assis/hplbpdkajdhlggncdpdmnkjldopmoomg
